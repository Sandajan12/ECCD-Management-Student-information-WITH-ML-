# =============================================================================
# AMES System - Backend Environment Configuration Template
# Copy this file to backend/.env and replace placeholders with your actual settings.
# =============================================================================

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/ames_db
# Hosted alternative (set one URL; DATABASE_URL takes precedence):
# SUPABASE_DB_URL=postgresql+psycopg2://USER:PASSWORD@YOUR_DB_HOST:5432/postgres?sslmode=verify-full
# DATABASE_SSL_ROOT_CERT=/etc/secrets/supabase-ca.crt
# Per process: at most size + overflow connections. Budget across all replicas.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=15
DATABASE_POOL_RECYCLE=300
# Mount the public CA for your actual Supabase endpoint, or set sslrootcert in URL.
# Exact frontend origins, comma separated; HTTPS is required in production.
CORS_ORIGINS=https://YOUR_FRONTEND.vercel.app

# Security & JWT Authentication
# Generate a secure 32-byte secret with the root Python 3.12 environment:
# uv run --no-project --python 3.12 python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secure_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ENVIRONMENT=development
# Production requires true and valid email credentials. False is local dev only.
ENABLE_OTP=true

# Backup Encryption (Fernet; backend/routes/backup.py)
# Generate using the root .venv:
# uv run --no-project --python 3.12 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use the generated 44-character URL-safe base64 key unchanged across restarts.
BACKUP_ENCRYPTION_KEY=replace_with_generated_fernet_key
# Required by Settings; currently unused by the Fernet backup implementation.
# Generate using: uv run --no-project --python 3.12 python -c "import secrets; print(secrets.token_hex(16))"
BACKUP_IV=replace_with_generated_32_hex_characters

# Phase 1 LRN protection. After configuring DATABASE_URL, create missing keys
# directly in backend/.env without printing them:
# uv run --no-project --python 3.12 python -m backend.scripts.configure_lrn
# LRN_ENCRYPTION_KEY=
# LRN_HMAC_SECRET=
# Preserve both keys with database backups; never rotate them independently.

# Email / SMTP Configuration (FastAPI-Mail)
# Render Free blocks SMTP ports; use Brevo HTTPS (443) with a verified sender.
EMAIL_TRANSPORT=brevo_api
BREVO_API_KEY=replace_with_your_brevo_api_key
# For local SMTP use EMAIL_TRANSPORT=smtp; SMTP credentials are separate.
# For Gmail, use an App Password (16 characters) generated under Google Account Security
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_app_password_here
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM=your_email@example.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# One-time fresh database bootstrap: set all three privately before running
# python -m backend.scripts.seed_supabase --apply (see backend/scripts/README.md).
# Existing Chairmen are preserved unless --update-chairman is explicitly used.
# INITIAL_CHAIRMAN_EMAIL=chairman@your-school.edu
# INITIAL_CHAIRMAN_PASSWORD=replace_with_a_unique_strong_password
# INITIAL_CHAIRMAN_NAME=School Chairman
