# =============================================================================
# AMES System - Frontend .gitignore
# =============================================================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & Build Output
node_modules/
dist/
dist-ssr/
build/
*.local
.env.local
.env.*.local

# Generated Tool Caches & Linters
.turbo/
.cache/
.vite/
.vite-temp/
*.tsbuildinfo
.eslintcache

# Playwright & Test Results (Test outputs only — never ignore test code or configs)
test-results/
nav-test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/

# Editor & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?