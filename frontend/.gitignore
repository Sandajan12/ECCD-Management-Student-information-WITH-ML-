.turbo/
.cache/
.vite/
.vite-temp/
*.tsbuildinfo
test-results/
nav-test-results/
playwright-report/
blob-report/
coverage/

# Editor files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
