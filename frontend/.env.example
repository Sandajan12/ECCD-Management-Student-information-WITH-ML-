# =============================================================================
# AMES System - Frontend Environment Configuration Template
# Copy this file to frontend/.env (or frontend/.env.local) if customizing API URL.
# =============================================================================

# Backend API Base URL (Code defaults to https://api.ameskinder.com; override below for local development if not specified)
VITE_API_URL=http://localhost:8000

# Optional Socket.IO origin; defaults to the API origin.
VITE_SOCKET_URL=http://localhost:8000

# Optional hosted parent APK URL. Blank/unset uses /downloads/ames-parent.apk.
# For that fallback, copy the signed APK to public/downloads/ames-parent.apk (ignored).
VITE_PARENT_APP_DOWNLOAD_URL=https://drive.google.com/file/d/1GjsVuLmhhjKZVLjJPB3ww-Ziou2xNMYd/view?usp=drive_link

# Verification screens follow backend challenge responses, including local OTP bypass.
