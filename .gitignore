# =============================================================================
# AMES System - Comprehensive Root .gitignore
# =============================================================================

# 1. Credentials & Environment Secrets (CRITICAL)
.env
.env.*
*.env
!*.env.example

# Private keys and database certificates
*.pem
*.key
*.p8
*.p12
*.pfx
id_rsa
id_ed25519
# Allow the public reference CA certificate for Aiven MySQL SSL
!backend/ca.pem
!**/ca.pem

# 2. Legacy Migration Reference & Raw Database Dumps
_legacy_reference/
AMES-SYSTEM-LEGACY/
*.sql
*.enc
!backend/tests/fixtures/phase1_baseline.sql

# 3. Virtual Environments & Dependencies
.venv/
.venv312/
venv/
env/
ENV/
env.bak/
venv.bak/
node_modules/
.pnpm-store/
npm-cache/
.npm/

# 4. Python Build, Cache & Test Outputs
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
backend/.pytest_cache/

# 5. Frontend & Build Outputs (Keeps frontend/tests/ tracked)
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/
dist/
*.local

# Generated caches, linters, and browser-test reports (test outputs only)
.turbo/
.cache/
.vite/
.vite-temp/
*.tsbuildinfo
.eslintcache
test-results/
nav-test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/

# 6. Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# 7. Operating System & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. Machine Learning Model Binaries
*.pkl
*.joblib
*.pt
*.pth
*.onnx
*.h5
*.bin
*.ckpt
# Production Model Whitelist: Keep inference model tracked for Render deployment
!backend/ml/rf_post_test_model.joblib
!backend/ml/artifacts/rf_post_test_model.joblib

# 9. Runtime Uploads, Generated Exports, and SQLite Databases
backend/uploads/
backend/exports/
uploads/
exports/
backups/
*.db
*.sqlite3
*.sqlite

# 10. Spreadsheets, Sensitive Student Data Exports & Templates
*.xlsx
*.xls
*.csv
backend/assets/templates/*.xlsx
backend/assets/templates/*.xls
# Reviewed blank DepEd templates
!backend/assets/templates/ECCD_Checklist_Blank_Template.xlsx
!backend/assets/templates/ECCD_Summary_Matrix_Template.xlsx

# 11. ML Raw Datasets, Benchmarks & Learner Microdata
backend/ml/raw_data/
backend/ml/data/
backend/ml/artifacts/real_beneficiary_benchmark.csv
backend/ml/artifacts/real_beneficiary_interventions.json
backend/ml/artifacts/dataset_audit.json
