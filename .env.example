# =============================================================================
# AMES System - Environment Configuration Template
# Copy this file to backend/.env and replace placeholders with your actual settings.
# =============================================================================

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/ames_db

# Security & JWT Authentication
# Generate a secure 32-byte secret key (e.g. using `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=your_secure_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Backup Encryption (AES-256-CBC)
# 32-character string for 256-bit encryption key
BACKUP_ENCRYPTION_KEY=your_32_character_backup_key_here
# 16-character string for AES initialization vector
BACKUP_IV=your_16_char_iv_here

# Email / SMTP Configuration (FastAPI-Mail)
# For Gmail, use an App Password (16 characters) generated under Google Account Security
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_app_password_here
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM=your_email@example.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
